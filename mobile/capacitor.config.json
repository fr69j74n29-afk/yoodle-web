{
  "appId": "ca.yoodle.app",
  "appName": "Yoodle",
  "webDir": "www",
  "backgroundColor": "#0A0A0A",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "version": "0.0.0",
      "appId": "ca.yoodle.app",
      "autoUpdate": "atBackground"
    }
  }
}
