{
  "appId": "ca.yoodle.app",
  "appName": "Yoodle",
  "webDir": "www",
  "backgroundColor": "#0A0A0A",
  "ios": {
    "contentInset": "never",
    "handleApplicationNotifications": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      },
      "logLevel": 1
    },
    "CapacitorUpdater": {
      "version": "0.0.0",
      "appId": "ca.yoodle.app",
      "autoUpdate": "atBackground"
    }
  }
}
